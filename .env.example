# iRacing Discord Bot & Last Race Details Environment Variables

# Discord Bot Token (required for the Discord bot)
# Get this from the Discord Developer Portal (https://discord.com/developers/applications)
# DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Set these variables to avoid entering credentials interactively
# IRACING_USERNAME=your_iracing_username
# IRACING_PASSWORD=your_iracing_password

# Note: For production use, it's better to use a secure secrets manager
# rather than storing credentials in environment variables.
# docker-compose.override.example
# Use this file for local development overrides
# Rename to docker-compose.override.yml to activate

services:
  python:
    # Uncomment for local development with live reload (requires watchdog)
    # command: python -m watchdog src --run python -m src.discord_bot
    environment:
      - DEBUG=true
      - LOG_LEVEL=DEBUG
      - POLL_INTERVAL_SECONDS=30  # Shorter interval for testing
    volumes:
      - ./data:/app/data          # Persist database across container restarts
      - ./src:/app/src            # Mount source code for live editing
    # Uncomment for debugging with ptrace (if needed)
    # cap_add:
    #   - SYS_PTRACE
    # security_opt:
    #   - seccomp:unconfined